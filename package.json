{
  "name": "02-weather",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "typecheck": "bun check",
    "compile": "bun build --compile ./src/index.ts --outfile dist/weather",
    "dev": "bun run src/index.ts --watch",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "build": "bun run typecheck && bun test && bun run compile"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
